---
import Base from "~/layouts/Base.astro";
import { Image } from "astro:assets";
import Section from "~/components/Section.astro";
import portrait from "~/assets/matthias.jpg";

const shifts = [
  {
    glyph: "converge",
    title: "Clear specs before code",
    text: "Agents build exactly what you specify. Wedecom helps you find out what that is.",
  },
  {
    glyph: "steps",
    title: "AI in every step",
    text: "Specs, code, verification, release. Agents prove their work with tests and the running app.",
  },
  {
    glyph: "fold",
    title: "A product engineer in your team",
    text: "Product, engineering and tech lead in one role. Owns the outcome, not the ticket.",
  },
];

// Effort per stage on the way from idea to shipped, drawn as waves:
// `at` is where a stage peaks on the timeline (0 to 1), `spread` how long
// it runs, `height` how much effort it takes. `slow` is the bottleneck.
type Wave = { stage: string; at: number; spread: number; height: number };
const effort: { name: string; summary: string; slow: string; waves: Wave[] }[] = [
  {
    name: "Before AI",
    summary: "Before AI, coding takes the most effort and shipping comes late.",
    slow: "Code",
    waves: [
      { stage: "Spec", at: 0.14, spread: 0.09, height: 0.3 },
      { stage: "Code", at: 0.42, spread: 0.13, height: 0.95 },
      { stage: "Verify", at: 0.68, spread: 0.07, height: 0.5 },
    ],
  },
  {
    name: "With AI",
    summary: "With AI, the spec still takes the most effort, but less waiting. Coding shrinks, and shipping comes earlier.",
    slow: "Spec",
    waves: [
      { stage: "Spec", at: 0.13, spread: 0.055, height: 0.62 },
      { stage: "Code", at: 0.27, spread: 0.035, height: 0.3 },
      { stage: "Verify", at: 0.385, spread: 0.05, height: 0.45 },
    ],
  },
];
const chartWidth = 600;
const baseline = 120;
const peak = 95;
const waveTop = (w: Wave) => baseline - peak * w.height;
const wavePath = (w: Wave) => {
  const points = [];
  for (let x = 0; x <= chartWidth; x += 4) {
    const y = baseline - peak * w.height * Math.exp(-((x / chartWidth - w.at) ** 2) / (2 * w.spread ** 2));
    points.push(`${x},${y.toFixed(1)}`);
  }
  return `M${points.join(" L")} L${chartWidth},${baseline} L0,${baseline} Z`;
};
// Shipped once the last wave has died out, three spreads past its peak.
const shippedAt = (waves: Wave[]) => Math.max(...waves.map((w) => w.at + 3 * w.spread)) * chartWidth;

const theses = [
  {
    line: "AI changes the organization, not only the code.",
    elab: "It changes who decides what, and how work gets specified, verified and shipped.",
  },
  {
    line: "Speed exposes weak systems.",
    elab: "Unclear specs and fragile architecture now fail faster.",
  },
  {
    line: "Review moves upstream.",
    elab: "People judge the spec and the design. Agents prove the code works, with tests and the running app.",
  },
];

const facts = [
  { term: "Experience", value: "20 years building production software" },
  { term: "Industries", value: "Banking, finance, insurance, medtech" },
  { term: "Based in", value: "Olching, near Munich" },
  { term: "Languages", value: "English, German, Polish" },
];

// Hero graph: one intent fans out into five slices; the proof gate at
// y=360 sends the rejected slice back up to the intent, the rest merge
// into "Shipped".
const lanes = [
  { x: 40, commits: [190, 280] },
  { x: 95, commits: [170, 235, 300] },
  { x: 150, commits: [210, 290] },
  { x: 205, commits: [200, 270], rejected: true },
  { x: 260, commits: [180, 250, 310] },
];
const goBack = "C300,330 300,300 300,250 L300,90 C300,40 200,40 161,40";
const fanOut = (x: number) => (x === 150 ? "M150,40 L150,140" : `M150,40 C150,100 ${x},90 ${x},140`);
const lanePath = ({ x, rejected }: { x: number; rejected?: boolean }) => {
  if (rejected) return `${fanOut(x)} L${x},318`;
  const fanIn = x === 150 ? "L150,500" : `C${x},440 150,440 150,500`;
  return `${fanOut(x)} L${x},390 ${fanIn}`;
};
const pulsePath = (l: { x: number; rejected?: boolean }) =>
  l.rejected ? `${fanOut(l.x)} L${l.x},330 ${goBack}` : lanePath(l);

const graphNotes = [
  { y: 38, label: "Intent", notes: ["Questioned until", "it is clear"] },
  { y: 228, label: "Small slices", notes: ["Agents build them,", "even overnight"] },
  { y: 358, label: "Proof", notes: ["Tests and the real app.", "Unproven work goes back."] },
  { y: 498, label: "Shipped", notes: ["Mistakes become rules", "for the next run"] },
];
---

<Base
  title="AI-native product teams | Wedecom Consulting, Munich"
  description="Wedecom helps startups and engineering leaders build AI-native product teams. Founder-led by Matthias Wesolowski, near Munich."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">Build an <span class="whitespace-nowrap">AI-native</span> product team.</h1>
        <p class="hero-sub">
          Wedecom helps startups and engineering leaders change how their
          teams plan, build, review and release software.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn">Get in touch</a>
        </div>
      </div>
      <div class="hero-graph">
        <svg viewBox="0 0 520 560" role="img" aria-labelledby="graph-title">
          <title id="graph-title">One intent is split into small slices that agents build. A proof gate sends one slice back to the intent; the verified slices merge and ship.</title>
          {lanes.map((l) => <path class="lane" d={lanePath(l)} />)}
          <path class="lane-back" d={`M205,330 ${goBack}`} />
          {lanes.map((l, i) => <path class={`lane-pulse lane-pulse-${i + 1}`} d={pulsePath(l)} pathLength="1000" />)}
          {lanes.flatMap((l) => l.commits.map((y) => <circle class="commit" cx={l.x} cy={y} r="5" />))}
          <path class="reject" d="M198,323 L212,337 M212,323 L198,337" />
          <path class="gate" d="M16,360 L284,360 M16,352 L16,368 M284,352 L284,368" />
          <circle class="intent" cx="150" cy="40" r="11" />
          <circle class="shipped" cx="150" cy="500" r="11" />
          {graphNotes.map((n) => (
            <g>
              <text class="graph-label" x="320" y={n.y}>{n.label}</text>
              {n.notes.map((t, i) => <text class="graph-note" x="320" y={n.y + 22 + i * 20}>{t}</text>)}
            </g>
          ))}
        </svg>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Section label="What changes" id="offer">
      <p class="lead">Faster code moves the bottleneck.</p>
      <div class="md-prose">
        <p>
          AI writes the code in minutes and speeds up research and specs too.
          The hard part is still deciding what you need and really want, and
          writing it down clearly enough to build.
        </p>
      </div>
      <figure class="effort">
        {effort.map((row, i) => (
          <div class="effort-row">
            <p class="effort-name" id={`effort-${i}`}>{row.name}</p>
            <svg viewBox={`0 0 ${chartWidth} 158`} role="img" aria-labelledby={`effort-${i} effort-${i}-summary`}>
              <title id={`effort-${i}-summary`}>{row.summary}</title>
              {row.waves.map((w) => <path class={w.stage === row.slow ? "wave wave-slow" : "wave"} d={wavePath(w)} />)}
              <line class="effort-base" x1="0" y1={baseline} x2={chartWidth} y2={baseline} />
              {row.waves.map((w) => (
                <text class={w.stage === row.slow ? "wave-label wave-label-slow" : "wave-label"} x={w.at * chartWidth} y={waveTop(w) - 10}>{w.stage}</text>
              ))}
              <circle class="effort-ship" cx={shippedAt(row.waves)} cy={baseline} r="7" />
              <text class="effort-ship-label" x={shippedAt(row.waves)} y={baseline + 26}>Shipped</text>
            </svg>
          </div>
        ))}
      </figure>
      <ul class="shifts">
        {shifts.map((s) => (
          <li>
            <svg class="glyph" viewBox="0 0 64 32" aria-hidden="true">
              {s.glyph === "converge" && (
                <>
                  {[[6, 4], [14, 28], [22, 12], [4, 20]].map(([x, y]) => <path class="glyph-faint" d={`M${x},${y} L54,16`} />)}
                  {[[6, 4], [14, 28], [22, 12], [4, 20]].map(([x, y]) => <circle class="glyph-node" cx={x} cy={y} r="3.5" />)}
                  <circle class="glyph-done" cx="54" cy="16" r="6" />
                </>
              )}
              {s.glyph === "steps" && (
                <>
                  <path class="glyph-faint" d="M4,16 L60,16" />
                  {[12, 26, 40, 54].map((x) => <circle class="glyph-done" cx={x} cy="16" r="5" />)}
                </>
              )}
              {s.glyph === "fold" && (
                <>
                  {[[12, 10], [26, 10], [19, 22]].map(([x, y]) => <circle class="glyph-ring" cx={x} cy={y} r="8" />)}
                  <circle class="glyph-done" cx="19" cy="14" r="4" />
                </>
              )}
            </svg>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </Section>
  </div>

  <div class="band">
    <div class="wrap">
      <Section label="Point of view" id="stance">
        <ul class="theses">
          {theses.map((t) => (
            <li>
              <strong>{t.line}</strong>
              <span>{t.elab}</span>
            </li>
          ))}
        </ul>
      </Section>
    </div>
  </div>

  <div class="wrap">
    <Section label="Who you work with" id="profile">
      <div class="founder">
        <Image src={portrait} alt="Matthias Wesolowski" width={200} height={200} densities={[1, 2]} class="founder-photo" />
        <div>
          <p class="lead founder-name">Matthias Wesolowski</p>
          <p class="founder-role">Product engineer. Founder of Wedecom.</p>
          <div class="md-prose">
            <p>
              Product owner, engineer and tech lead in one person, with the
              product sense to find out what customers really need. AI covers
              research and subject-matter questions, so he rarely waits on
              others and moves faster on his own. Startups
              bring him in to build AI-native teams, and he owns the outcome:
              from the first question about the customer to the release and
              what happens after it.
            </p>
          </div>
          <dl class="facts">
            {facts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </Section>
  </div>

  <section id="begin" class="closing">
    <div class="wrap">
      <h2 class="closing-title">Talk to Matthias.</h2>
      <div class="closing-grid">
        <p>
          Bring the product you need to ship, the bottleneck slowing the team
          down, or the AI adoption question that keeps coming back. Matthias
          will tell you what he would change first.
        </p>
        <div>
          <a href="/contact" class="closing-link">Send a message</a>
          <p class="closing-alt">
            or on <a href="https://www.linkedin.com/in/matthias-wesolowski-320b033b/" target="_blank" rel="noopener noreferrer" class="ink-link">LinkedIn</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
