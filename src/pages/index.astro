---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";

const stance = [
  {
    line: "AI changes more than the editor.",
    elab: "It changes how teams make product decisions, design systems, and move work from idea to production.",
  },
  {
    line: "Speed exposes weak systems.",
    elab: "AI makes strong teams faster. It also makes unclear product thinking and fragile architecture fail faster.",
  },
  {
    line: "The whole delivery loop has to change.",
    elab: "Faster coding pays off only when deciding, reviewing, and releasing speed up with it.",
  },
];
---

<Base
  title="Wedecom Consulting GmbH | Software delivery redesigned for AI"
  description="Wedecom helps founders and engineering leaders redesign software delivery around AI. Founder-led by Matthias Wesolowski, near Munich."
>
  <section id="top" class="slab slab--hero">
    <div class="md-wide hero-grid">
      <div class="hero-col">
        <h1 class="hero-thesis-h1">
          Redesign the delivery loop<br />around AI.<span class="hero-caret" aria-hidden="true"></span>
        </h1>
        <p class="hero-thesis-sub">
          Wedecom helps founders and engineering leaders change how their
          teams plan, build, review, and release software with AI.
        </p>
        <p class="hero-thesis-question">
          Tools alone won't change the loop.
        </p>
        <p class="hero-cta-line">
          <a href="#begin" class="hero-cta-link">Let's talk</a>
        </p>
      </div>
    </div>
  </section>

  <article class="md-wide pt-12 pb-20 md:pt-16 md:pb-24">

    <Section label="How Wedecom helps" id="offer">
      <div class="md-prose md-col">
        <p>
          Most teams start with AI coding assistants and get more code. The
          bottleneck then moves to unclear requirements, slow reviews, fragile
          architecture, and risky releases.
        </p>
        <p>
          Wedecom works inside your product and engineering team and changes
          the whole delivery loop, from how the team specifies work to how it
          reviews, tests, and releases it.
        </p>
      </div>

      <div class="md-shapes">
        <div class="md-shape">
          <p class="shape-n">01</p>
          <p class="shape-key">Shorter path to shipped product</p>
          <p class="shape-text">
            Fewer steps and handoffs between a product decision and working code in production.
          </p>
        </div>
        <div class="md-shape">
          <p class="shape-n">02</p>
          <p class="shape-key">AI across delivery</p>
          <p class="shape-text">
            AI in coding, tests, code review, documentation, debugging, and releases, with tests and reviews that catch what the AI gets wrong.
          </p>
        </div>
        <div class="md-shape">
          <p class="shape-n">03</p>
          <p class="shape-key">Senior delivery ownership</p>
          <p class="shape-text">
            One experienced engineer who makes product, architecture, implementation, and rollout decisions together with your team.
          </p>
        </div>
      </div>
    </Section>

    <Section label="Point of view" id="stance">
      <ol class="md-credo md-col">
        {stance.map((c, i) => (
          <li>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}.</span>
            <span class="line">{c.line}</span>
            <span class="elab">{c.elab}</span>
          </li>
        ))}
      </ol>
    </Section>

    <Section label="Founder-led" id="profile">
      <div class="md-prose md-col">
        <p>
          Wedecom is led by <strong>Matthias Wesolowski</strong>, a software
          engineer near Munich. He has built production software for twenty
          years, in banking, finance, insurance, and medtech.
        </p>
        <p>
          He helps teams decide what to build, how to structure it, where AI
          helps and where it adds risk, and how to ship it.
        </p>
        <p>
          Matthias works directly in the team's repositories, code reviews, and
          planning sessions.
        </p>
      </div>
    </Section>

  </article>

  <section id="begin" class="slab reveal mt-16 md:mt-24">
    <div class="md-wide">
      <h2 class="md-h2"><span class="label-text">Next step</span></h2>
      <p class="cta-headline">Talk to <em>Matthias</em>.</p>
      <div class="md-prose md-col">
        <p>
          Bring the product you need to ship, the bottleneck slowing the team
          down, or the AI adoption question that keeps coming back. Matthias
          will tell you what he would change first.
        </p>
      </div>
      <p class="cta-primary">
        <a href="mailto:info@wedecom-consulting.de" class="cta-primary-link">info@wedecom-consulting.de</a>
      </p>
      <p class="cta-secondary">
        or via <a href="https://www.linkedin.com/in/matthias-wesolowski-320b033b/" target="_blank" rel="noopener noreferrer" class="ink-link">LinkedIn ↗</a>
      </p>
    </div>
  </section>
</Base>
