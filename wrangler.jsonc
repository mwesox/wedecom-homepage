{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedecom-homepage",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "wedecom-consulting.de", "custom_domain": true },
    { "pattern": "www.wedecom-consulting.de", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": false }
}
