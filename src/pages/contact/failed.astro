---
import Base from "~/layouts/Base.astro";
---

<Base
  title="Message not sent | Wedecom Consulting GmbH"
  description="Your message to Wedecom Consulting GmbH did not go through."
>
  <article class="wrap page">
    <h1 class="md-title">Message not sent</h1>
    <div class="md-prose">
      <p>
        The message did not go through. This happens when a field is invalid,
        when too many messages come from one network in a short time, or when
        the mail service is down. Nothing was saved.
      </p>
    </div>
    <div class="mt-10 border-t border-line pt-6">
      <p class="md-arrow">
        <a href="/contact" class="ink-link">Back to the form</a>
      </p>
      <p class="md-arrow">
        <a href="https://www.linkedin.com/in/matthias-wesolowski-320b033b/" target="_blank" rel="noopener noreferrer" class="ink-link">LinkedIn ↗</a>
      </p>
    </div>
  </article>
</Base>
