---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";

const stops = [
  { label: "Decide", x: 200, y: 50, lx: 200, ly: 28, anchor: "middle" },
  { label: "Build", x: 350, y: 200, lx: 368, ly: 205, anchor: "start" },
  { label: "Review", x: 200, y: 350, lx: 200, ly: 383, anchor: "middle" },
  { label: "Release", x: 50, y: 200, lx: 32, ly: 205, anchor: "end" },
];

const shifts = [
  {
    title: "Shorter path to shipped product",
    text: "Fewer steps and handoffs between a product decision and working code in production.",
  },
  {
    title: "AI across delivery",
    text: "AI in coding, tests, code review, documentation, debugging, and releases, with tests and reviews that catch what the AI gets wrong.",
  },
  {
    title: "Senior delivery ownership",
    text: "One experienced engineer who makes product, architecture, implementation, and rollout decisions together with your team.",
  },
];

const theses = [
  {
    line: "AI changes more than the editor.",
    elab: "It changes how teams make product decisions, design systems, and move work from idea to production.",
  },
  {
    line: "Speed exposes weak systems.",
    elab: "AI makes strong teams faster. It also makes unclear product thinking and fragile architecture fail faster.",
  },
  {
    line: "The whole delivery loop has to change.",
    elab: "Faster coding pays off only when deciding, reviewing, and releasing speed up with it.",
  },
];

const facts = [
  { term: "Since 2024", value: "Several startups, advising and building alongside their teams" },
  { term: "Experience", value: "20 years building production software" },
  { term: "Industries", value: "Banking, finance, insurance, medtech" },
  { term: "Based in", value: "Olching, near Munich" },
  { term: "Languages", value: "English, German, Polish" },
];

const loop = "M200,50 A150,150 0 1,1 200,350 A150,150 0 1,1 200,50";
---

<Base
  title="Wedecom Consulting GmbH | AI-native product teams"
  description="Wedecom helps startups and engineering leaders build AI-native product teams. Founder-led by Matthias Wesolowski, near Munich."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">Build an <span class="whitespace-nowrap">AI-native</span> product team.</h1>
        <p class="hero-sub">
          Wedecom helps startups and engineering leaders change how their
          teams plan, build, review, and release software, based on two years
          of <span class="whitespace-nowrap">hands-on</span> work inside startups.
        </p>
        <div class="hero-actions">
          <a href="mailto:info@wedecom-consulting.de" class="btn">Email Matthias</a>
        </div>
      </div>
      <div class="hero-loop">
        <svg viewBox="-60 0 520 400" role="img" aria-labelledby="loop-title">
          <title id="loop-title">The delivery loop: decide, build, review, release, with AI at the center</title>
          <circle class="loop-inner" cx="200" cy="200" r="100" />
          <path class="loop-track" d={loop} />
          <path class="loop-signal" d={loop} pathLength="1000" />
          {stops.map((s) => (
            <g>
              <circle class="loop-stop" cx={s.x} cy={s.y} r="7" />
              <text class="loop-label" x={s.lx} y={s.ly} text-anchor={s.anchor}>{s.label}</text>
            </g>
          ))}
          <text class="loop-core" x="200" y="228" text-anchor="middle">AI</text>
        </svg>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Section label="What changes" id="offer">
      <p class="lead">Faster code moves the bottleneck.</p>
      <div class="md-prose">
        <p>
          Most teams start with AI coding assistants. The work then piles up
          at unclear requirements, slow reviews, fragile architecture, and
          risky releases.
        </p>
        <p>
          Wedecom works inside your team and sets up how an AI-native
          organization works, from how the team specifies work to how it
          reviews, tests, and releases it.
        </p>
      </div>
      <ul class="shifts">
        {shifts.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section label="Point of view" id="stance">
      <ul class="theses">
        {theses.map((t) => (
          <li>
            <strong>{t.line}</strong>
            <span>{t.elab}</span>
          </li>
        ))}
      </ul>
    </Section>

    <Section label="Who you work with" id="profile">
      <div class="founder">
        <div class="md-prose">
          <p>
            Wedecom is led by <strong>Matthias Wesolowski</strong>, a software
            engineer who has built production software for twenty years.
          </p>
          <p>
            Since 2024 he has worked with several startups, as advisor and as
            engineer in their codebase. There he learned how an AI-native
            organization runs and what it takes to build one.
          </p>
          <p>
            He helps teams decide what to build, how to structure it, where AI
            helps and where it adds risk, and how to ship it.
          </p>
          <p>
            Matthias works directly in the team's repositories, code reviews,
            and planning sessions.
          </p>
        </div>
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>
  </div>

  <section id="begin" class="closing">
    <div class="wrap">
      <h2 class="closing-title">Talk to Matthias.</h2>
      <div class="closing-grid">
        <p>
          Bring the product you need to ship, the bottleneck slowing the team
          down, or the AI adoption question that keeps coming back. Matthias
          will tell you what he would change first.
        </p>
        <div>
          <a href="mailto:info@wedecom-consulting.de" class="closing-mail">info@wedecom-consulting.de</a>
          <p class="closing-alt">
            or on <a href="https://www.linkedin.com/in/matthias-wesolowski-320b033b/" target="_blank" rel="noopener noreferrer" class="ink-link">LinkedIn</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
