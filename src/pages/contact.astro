---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
---

<Base
  title="Contact | Wedecom Consulting GmbH"
  description="Contact Matthias Wesolowski at Wedecom Consulting GmbH by e-mail or LinkedIn."
>
  <article class="wrap page">
    <h1 class="md-title">Contact</h1>

    <Section label="Get in touch" id="reach">
      <div class="md-prose">
        <p>
          Write a few lines about what you want to ship, where delivery is
          slow, and where you think AI could help. One conversation is usually
          enough to tell whether Wedecom is a fit.
        </p>
        <p>
          Matthias answers every message himself. He works in English and
          German with clients across Europe, especially in the DACH region.
        </p>
      </div>
      <div class="mt-7">
        <p class="md-arrow">
          <a href="mailto:info@wedecom-consulting.de" class="ink-link">info@wedecom-consulting.de</a>
        </p>
        <p class="md-arrow">
          <a href="https://www.linkedin.com/in/matthias-wesolowski-320b033b/" target="_blank" rel="noopener noreferrer" class="ink-link">
            linkedin.com/in/matthias-wesolowski ↗
          </a>
        </p>
      </div>
    </Section>

    <Section label="Office" id="office">
      <div class="md-prose">
        <p>
          Wedecom Consulting GmbH<br />
          Estostr. 13A · 82140 Olching, near Munich, Germany<br />
          HRB 229467 · Amtsgericht München
        </p>
      </div>
    </Section>
  </article>
</Base>
